<Window x:Class="uLEAPP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="uLEAPP" Width="1040" Height="820" MinWidth="820" MinHeight="640"
        Background="#111712" Foreground="White" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Closing="WindowClosing">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#A7B4AB" />
    <Style TargetType="Button">
      <Setter Property="Background" Value="#2B352D" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="15,10" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#8EE563" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="20,20,20,16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="*" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,14">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Image Source="uLEAPP.png" Width="54" Height="54" Margin="0,0,16,0" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="uLEAPP" FontSize="28" FontWeight="Bold" />
        <TextBlock Text="One place. Every LEAPP up to date." FontSize="12" Foreground="{StaticResource Muted}" Margin="0,5,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
        <Border CornerRadius="12" BorderBrush="#46814B" BorderThickness="1" Padding="10,6"><TextBlock Text="{Binding PlatformLabel}" Foreground="#8EE563" FontSize="10" /></Border>
        <Button Content="About" Click="AboutClicked" FontSize="11" Background="Transparent" Padding="8,6" Margin="0,5,0,0" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" CornerRadius="14" Background="#1C241E" BorderBrush="#303C32" BorderThickness="1" Padding="14" Margin="0,0,0,12">
      <StackPanel>
        <TextBlock Text="{Binding StatusTitle}" FontSize="16" FontWeight="SemiBold" Foreground="#8EE563" />
        <TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,7,0,0" />
        <ProgressBar Maximum="1" Value="{Binding Progress}" Height="5" Margin="0,14,0,0" Foreground="#8EE563" Background="#303C32" BorderThickness="0" Visibility="{Binding ProgressVisibility}" />
        <TextBlock Text="{Binding Phase}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding ProgressVisibility}" />
      </StackPanel>
    </Border>
    <DockPanel Grid.Row="2" Margin="3,0,3,10">
      <TextBlock Text="{Binding InstalledSummary}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11" />
      <TextBlock Text="YOUR LEAPP TOOLS" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" />
    </DockPanel>
    <Border Grid.Row="3" CornerRadius="14" Background="#1C241E" BorderBrush="#303C32" BorderThickness="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Rows}" IsEnabled="{Binding ActionsEnabled}">
          <ItemsControl.ItemTemplate><DataTemplate>
            <Border BorderBrush="#303C32" BorderThickness="0,0,0,1" Padding="12,6">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="40" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}" Width="30" Height="30" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,10,0">
                  <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" />
                  <TextBlock Text="{Binding Detail}" FontSize="10" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0" ToolTip="{Binding Detail}" />
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="12" Background="#29372B" Padding="9,6" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="200">
                  <TextBlock Text="{Binding PillLabel}" ToolTip="{Binding StatusHelp}" Foreground="{Binding StatusColor}" FontSize="11" TextWrapping="Wrap" />
                </Border>
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                  <Button Content="{Binding ActionLabel}" Visibility="{Binding ActionVisibility}" Tag="{Binding}" Click="RowActionClicked" Padding="9,5" FontSize="10" MinWidth="58" />
                  <Button Content="Launch" Tag="{Binding}" Click="LaunchClicked" Padding="5,3" FontSize="10" Background="Transparent" Foreground="{StaticResource Muted}" IsEnabled="{Binding IsInstalled}" Margin="6,0,0,0" />
                </StackPanel>
                <Button Grid.Column="4" Content="⋯" Tag="{Binding}" Click="RowMenuClicked" Background="Transparent" Foreground="{StaticResource Muted}" Padding="7,5" FontSize="14" AutomationProperties.Name="More tool actions" />
              </Grid>
            </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    <StackPanel Grid.Row="4" Margin="0,10,0,10">
      <DockPanel>
        <Button DockPanel.Dock="Right" Click="RemoveOldClicked" IsEnabled="{Binding ActionsEnabled}" Padding="8,5" FontSize="10" Background="Transparent" Foreground="{StaticResource Muted}" AutomationProperties.Name="Remove old installs">
          <StackPanel Orientation="Horizontal"><TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE74D;" Margin="0,0,6,0" /><TextBlock Text="Remove old installs" /></StackPanel>
        </Button>
        <StackPanel Orientation="Horizontal">
          <Expander x:Name="SettingsToggle" Header="Settings" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,0,12,0" />
          <Expander x:Name="DetailsToggle" Header="Details" Foreground="{StaticResource Muted}" FontSize="12" IsExpanded="{Binding DetailsExpanded}" />
        </StackPanel>
      </DockPanel>
      <StackPanel Margin="0,6,0,6">
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsExpanded, ElementName=SettingsToggle}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <CheckBox Content="Check for uLEAPP updates automatically" IsChecked="{Binding AutomaticUpdates}" IsEnabled="{Binding UpdatePreferenceEnabled}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6" />
        <TextBlock Text="Checks run at startup and once a day. Downloading an update is your choice." FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6" />
        <CheckBox Content="Create Start menu shortcuts" IsChecked="{Binding CreateStartMenuShortcuts}" IsEnabled="{Binding ShortcutPreferenceEnabled}" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,0,0,6" />
        <TextBlock Text="Adds shortcuts after successful installs and updates. Your own shortcuts are kept." FontSize="10" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6" />
        <DockPanel>
          <Button Content="Choose folder" DockPanel.Dock="Right" Click="ChooseFolderClicked" IsEnabled="{Binding ActionsEnabled}" Padding="8,5" FontSize="10" Background="Transparent" Foreground="#8EE563" />
          <TextBlock Text="{Binding InstallFolder}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" ToolTip="{Binding InstallFolder}" />
        </DockPanel>
      </StackPanel>
      <StackPanel Margin="0,6,0,0">
        <StackPanel.Style><Style TargetType="StackPanel"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsExpanded, ElementName=DetailsToggle}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></StackPanel.Style>
        <TextBox Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="100" Background="#0C100D" Foreground="{StaticResource Muted}" BorderThickness="0" FontFamily="Consolas" FontSize="10" Padding="10" />
        <Button Content="Copy log" Click="CopyLogClicked" Background="Transparent" Foreground="{StaticResource Muted}" FontSize="10" Padding="5" HorizontalAlignment="Right" />
      </StackPanel>
    </StackPanel>
    <Grid Grid.Row="5">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <StackPanel Visibility="{Binding AppUpdateVisibility}" Margin="0,0,0,6">
          <TextBlock Text="{Binding AppUpdateLabel}" Foreground="#8EE563" FontSize="11" />
          <StackPanel Orientation="Horizontal">
            <Button Content="Download update" Click="DownloadSelfUpdate" Padding="7,4" FontSize="10" />
            <Button Content="Release notes" Click="SelfUpdateNotes" Padding="7,4" FontSize="10" Margin="5,0,0,0" />
          </StackPanel>
        </StackPanel>
        <TextBlock Text="{Binding FooterStatus}" Foreground="{StaticResource Muted}" FontSize="10" Margin="0,0,0,4" />
        <Button Content="{Binding MissingLabel}" Click="InstallMissingClicked" IsEnabled="{Binding InstallMissingEnabled}" Background="Transparent" Foreground="#8EE563" FontSize="11" Padding="0,5" HorizontalAlignment="Left" Visibility="{Binding MissingVisibility}" />
        <Button Content="{Binding StopLabel}" Click="StopClicked" IsEnabled="{Binding StopEnabled}" Background="Transparent" Foreground="{StaticResource Muted}" FontSize="11" Padding="0,5" HorizontalAlignment="Left" Visibility="{Binding ProgressVisibility}" />
      </StackPanel>
      <Button Grid.Column="1" Content="Check for updates" Click="CheckClicked" IsEnabled="{Binding ActionsEnabled}" Margin="10,0,10,0" />
      <Button Grid.Column="2" Content="{Binding PrimaryLabel}" Visibility="{Binding PrimaryVisibility}" Click="PrimaryClicked" IsEnabled="{Binding ActionsEnabled}" Background="#8EE563" Foreground="#15210F" />
    </Grid>
  </Grid>
</Window>
