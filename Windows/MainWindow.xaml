<Window x:Class="uLEAPP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="uLEAPP" Width="930" Height="900" MinWidth="820" MinHeight="720"
        Background="#111712" Foreground="White" WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" Closing="WindowClosing">
  <Window.Resources>
    <SolidColorBrush x:Key="Muted" Color="#A7B4AB" />
    <Style TargetType="Button">
      <Setter Property="Background" Value="#2B352D" />
      <Setter Property="Foreground" Value="White" />
      <Setter Property="Padding" Value="15,10" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Cursor" Value="Hand" />
      <Setter Property="Template">
        <Setter.Value><ControlTemplate TargetType="Button">
          <Border x:Name="Surface" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Opacity" Value="0.8" /></Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="BorderBrush" Value="#8EE563" /><Setter TargetName="Surface" Property="BorderThickness" Value="2" /></Trigger>
            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Surface" Property="Opacity" Value="0.4" /></Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value>
      </Setter>
    </Style>
  </Window.Resources>
  <Grid Margin="28,28,28,22">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" /><RowDefinition Height="*" />
      <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Margin="0,0,0,22">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <Image Source="uLEAPP.png" Width="72" Height="72" Margin="0,0,16,0" />
      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Text="uLEAPP" FontSize="34" FontWeight="Bold" />
        <TextBlock Text="One place. Every LEAPP up to date." FontSize="14" Foreground="{StaticResource Muted}" Margin="0,5,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
        <Border CornerRadius="12" BorderBrush="#46814B" BorderThickness="1" Padding="10,6"><TextBlock Text="{Binding PlatformLabel}" Foreground="#8EE563" FontSize="10" /></Border>
        <Button Content="About" Click="AboutClicked" FontSize="11" Background="Transparent" Padding="8,6" Margin="0,5,0,0" />
      </StackPanel>
    </Grid>
    <Border Grid.Row="1" CornerRadius="14" Background="#1C241E" BorderBrush="#303C32" BorderThickness="1" Padding="20" Margin="0,0,0,20">
      <StackPanel>
        <TextBlock Text="{Binding StatusTitle}" FontSize="18" FontWeight="SemiBold" Foreground="#8EE563" />
        <TextBlock Text="{Binding StatusDetail}" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,7,0,0" />
        <ProgressBar Maximum="1" Value="{Binding Progress}" Height="5" Margin="0,14,0,0" Foreground="#8EE563" Background="#303C32" BorderThickness="0" Visibility="{Binding ProgressVisibility}" />
        <TextBlock Text="{Binding Phase}" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0" Visibility="{Binding ProgressVisibility}" />
      </StackPanel>
    </Border>
    <DockPanel Grid.Row="2" Margin="3,0,3,10">
      <TextBlock Text="{Binding InstalledSummary}" DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="{StaticResource Muted}" FontSize="11" />
      <TextBlock Text="YOUR LEAPP TOOLS" Foreground="{StaticResource Muted}" FontSize="10" FontWeight="SemiBold" />
    </DockPanel>
    <Border Grid.Row="3" CornerRadius="14" Background="#1C241E" BorderBrush="#303C32" BorderThickness="1">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ItemsControl ItemsSource="{Binding Rows}" IsEnabled="{Binding ActionsEnabled}">
          <ItemsControl.ItemTemplate><DataTemplate>
            <Border BorderBrush="#303C32" BorderThickness="0,0,0,1" Padding="16,13">
              <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="46" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Image Source="{Binding Icon}" Width="44" Height="44" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" VerticalAlignment="Center" HorizontalAlignment="Left" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="7,0,10,0">
                  <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{Binding Version}" Foreground="{StaticResource Muted}" FontSize="11" Margin="9,3,0,0" /></StackPanel>
                  <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,5,0,0" />
                  <TextBlock Text="{Binding Latest}" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,3,0,0" />
                </StackPanel>
                <Border Grid.Column="2" CornerRadius="12" Background="#29372B" Padding="9,6" VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="200">
                  <TextBlock Text="{Binding Status}" Foreground="{Binding StatusColor}" FontSize="11" TextWrapping="Wrap" />
                </Border>
                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                  <Button Content="{Binding ActionLabel}" Visibility="{Binding ActionVisibility}" Tag="{Binding}" Click="RowActionClicked" Padding="11,7" FontSize="11" MinWidth="62" />
                  <Button Content="Launch" Tag="{Binding}" Click="LaunchClicked" Padding="5,3" FontSize="10" Background="Transparent" Foreground="{StaticResource Muted}" IsEnabled="{Binding IsInstalled}" Margin="0,3,0,0" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>
    <StackPanel Grid.Row="4" Margin="0,14,0,14">
      <DockPanel>
        <Button Content="Choose folder" DockPanel.Dock="Right" Click="ChooseFolderClicked" IsEnabled="{Binding ActionsEnabled}" Padding="8,5" FontSize="10" Background="Transparent" Foreground="#8EE563" />
        <TextBlock Text="{Binding InstallFolder}" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Muted}" FontSize="10" VerticalAlignment="Center" ToolTip="{Binding InstallFolder}" />
      </DockPanel>
      <Expander Header="Details" Foreground="{StaticResource Muted}" Margin="0,6,0,0" IsExpanded="{Binding DetailsExpanded}">
        <StackPanel>
          <TextBox Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Height="100" Background="#0C100D" Foreground="{StaticResource Muted}" BorderThickness="0" FontFamily="Consolas" FontSize="10" Padding="10" />
          <Button Content="Copy log" Click="CopyLogClicked" Background="Transparent" Foreground="{StaticResource Muted}" FontSize="10" Padding="5" HorizontalAlignment="Right" />
        </StackPanel>
      </Expander>
    </StackPanel>
    <Grid Grid.Row="5">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
        <Button Content="{Binding MissingLabel}" Click="InstallMissingClicked" IsEnabled="{Binding InstallMissingEnabled}" Background="Transparent" Foreground="#8EE563" FontSize="11" Padding="0,5" HorizontalAlignment="Left" Visibility="{Binding MissingVisibility}" />
        <Button Content="{Binding StopLabel}" Click="StopClicked" IsEnabled="{Binding StopEnabled}" Background="Transparent" Foreground="{StaticResource Muted}" FontSize="11" Padding="0,5" HorizontalAlignment="Left" Visibility="{Binding ProgressVisibility}" />
      </StackPanel>
      <Button Grid.Column="1" Content="Check for updates" Click="CheckClicked" IsEnabled="{Binding ActionsEnabled}" Margin="10,0,10,0" />
      <Button Grid.Column="2" Content="{Binding PrimaryLabel}" Visibility="{Binding PrimaryVisibility}" Click="PrimaryClicked" IsEnabled="{Binding ActionsEnabled}" Background="#8EE563" Foreground="#15210F" />
    </Grid>
  </Grid>
</Window>
